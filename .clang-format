# To format every C++ file, run this from the repo root:
#   git ls-files -co --exclude-standard '*.cpp' '*.cc' '*.hpp' '*.h' | xargs clang-format -i
# To check without changing anything, as CI does, use --dry-run --Werror instead of -i.
BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
PointerAlignment: Left
DerivePointerAlignment: false
Standard: c++20
IncludeBlocks: Regroup
